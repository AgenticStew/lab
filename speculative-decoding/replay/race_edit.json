  "text": "\"\"\"Rolling statistics for a stream of GPU power readings (watts).\"\"\"\nfrom collections import deque\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass Reading:\n    t: float      # seconds since start\n    watts: float\n\n\n@dataclass\nclass RollingStats:\n    window: int = 8\n    _buf: deque = field(default_factory=deque)\n    _total: float = 0.0\n\n    def add(self, r: Reading) -> None:\n        self._buf.append(r)\n        self._total += r.watts\n        if len(self._buf) > self.window:\n            old = self._buf.popleft()\n            self._total -= old.watts\n\n    def mean(self) -> float:\n        if not self._buf:\n            return 0.0\n        return self._total / len(self._buf)\n\n    def peak(self) -> float:\n        return max((r.watts for r in self._buf), default=0.0)\n\n\ndef moving_average(values: list[float], k: int) -> list[float]:\n    \"\"\"Mean of every run of k consecutive values, in order.\"\"\"\n    if k <= 0:\n        raise ValueError(\"k must be positive\")\n    out = []\n    for i in range(len(values) - k + 1):\n        out.append(sum(values[i:i + k]) / k)\n    return out\n\n\ndef energy_joules(readings: list[Reading]) -> float:\n    \"\"\"Trapezoid rule over the readings.\"\"\"\n    total = 0.0\n    for a, b in zip(readings, readings[1:]):\n        total += (b.t - a.t) * (a.watts + b.watts) / 2\n    return total\n\n\ndef summarize(readings: list[Reading], window: int = 8) -> dict:\n    stats = RollingStats(window=window)\n    for r in readings:\n        stats.add(r)\n    return {\n        \"samples\": len(readings),\n        \"last_mean_w\": round(stats.mean(), 1),\n        \"last_peak_w\": round(stats.peak(), 1),\n        \"energy_j\": round(energy_joules(readings), 1),\n        \"smoothed\": moving_average([r.watts for r in readings], 4),",
