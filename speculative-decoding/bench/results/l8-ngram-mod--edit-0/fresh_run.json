    "text": "```python\nimport csv\nfrom collections import defaultdict\n\n\ndef load_rows(path):\n    \"\"\"\n    Loads rows from a CSV file into a list of dictionaries.\n\n    Args:\n        path (str): Path to the CSV file.\n\n    Returns:\n        list: List of dictionaries, where each dictionary represents a row in the CSV file.\n    \"\"\"\n    rows = []\n    with open(path, newline=\"\") as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            rows.append(row)\n    return rows\n\n\ndef sum_by_region(rows):\n    \"\"\"\n    Calculates the total amount for each region.\n\n    Args:\n        rows (list): List of dictionaries, where each dictionary represents a row in the CSV file.\n\n    Returns:\n        dict: Dictionary where keys are region names and values are total amounts.\n    \"\"\"\n    total = defaultdict(float)\n    for row in rows:\n        region = row[\"region\"].strip().title()\n        amount = float(row[\"amount\"])\n        total[region] += amount\n    return dict(total)\n\n\ndef top_regions(rows, n=3):\n    \"\"\"\n    Returns the top N regions by total amount.\n\n    Args:\n        rows (list): List of dictionaries, where each dictionary represents a row in the CSV file.\n        n (int, optional): Number of top regions to return. Defaults to 3.\n\n    Returns:\n        list: List of tuples, where each tuple contains a region name and its total amount.\n    \"\"\"\n    total = sum_by_region(rows)\n    ranked = sorted(total.items(), key=lambda kv: kv[1], reverse=True)\n    return ranked[:n]\n\n\ndef monthly_totals(rows):\n    \"\"\"\n    Calculates the total amount for each month.\n\n    Args:\n        rows (list): List of dictionaries, where each dictionary represents a row in the CSV file.\n\n    Returns:\n        dict: Dictionary where keys are month names and values are total amounts.\n    \"\"\"\n    total = defaultdict(float)\n    for row in rows:\n        month = row[\"date\"][:7]\n        total[month] += float(row[\"amount\"])\n    return dict(sorted(total.items()))\n\n\ndef report(path):\n    \"\"\"\n    Prints a report of top regions and monthly totals.\n\n    Args:\n        path (str): Path to the CSV file.\n    \"\"\"\n    rows = load_rows(path)\n    total = top_regions(rows)\n    for region, amount in total:\n        print(f\"{region:<12} {amount:>10.2f}\")\n    for month, amount in monthly_totals(rows).items():\n",
